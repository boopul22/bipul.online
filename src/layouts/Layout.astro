---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bipul Kumar — generalist builder",
  description = "Generalist. Whatever the project needs, I learn it and ship it. I make small tools that solve real problems. Consistency beats talent. Action beats intention.",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://boopul.online");
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("/profile.png", siteUrl).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Bipul Kumar",
    url: siteUrl.href,
    image: ogImage,
    description,
    sameAs: [
      "https://github.com/boopul22",
      "https://instagram.com/bipul.skill",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Bipul Kumar",
    url: siteUrl.href,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bipul Kumar" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- OG image -->
    <meta property="og:image" content={ogImage} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Rubik font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
