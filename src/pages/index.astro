---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectStats from "../components/projects/ProjectStats.astro";
import ProjectTabs from "../components/projects/ProjectTabs.astro";
import { getCollection } from "astro:content";
import { loadProgress, mergeProgress } from "../lib/progress";

// Rendered on request so the project cards show progress synced from
// OpenSEO without a redeploy. The edge cache keeps KV reads cheap.
export const prerender = false;

const email = "hello@bipul.online";

const payload = await loadProgress();
const sites = mergeProgress(payload);

Astro.response.headers.set(
  "cache-control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=600",
);

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const card = "rounded-xl border border-border bg-foreground/[0.02] p-4 sm:p-5";
const sectionHead = "flex items-center justify-between gap-3";
const moreLink =
  "inline-flex min-h-[44px] items-center text-sm font-medium text-muted hover:text-foreground sm:min-h-0";
const elsewhere = [
  { label: "Email", prefix: "hello(at)", value: "bipul.online", href: `mailto:${email}`, external: false },
  { label: "GitHub", prefix: "github.com/", value: "boopul22", href: "https://github.com/boopul22", external: true },
  { label: "Instagram", prefix: "instagram.com/", value: "bipul.skill", href: "https://instagram.com/bipul.skill", external: true },
];
---

<Layout>
  <SiteHeader active="home" />

  <section class="reveal flex items-center gap-4 sm:gap-5" style="--i: 1">
    <img
      src="/profile.png"
      alt="Bipul Kumar"
      loading="lazy"
      decoding="async"
      width="256"
      height="256"
      class="size-16 rounded-full ring-1 ring-border md:size-20"
    />
    <div class="flex flex-col gap-1">
      <h1 class="text-lg font-semibold tracking-tight text-foreground md:text-xl">
        Bipul Kumar
      </h1>
      <p class="text-sm text-balance text-secondary">
        Web Builder &bull; Automation &bull; SEO &bull; Social Media
      </p>
    </div>
  </section>

  <ProjectStats sites={sites} class="reveal" style="--i: 2" />

  <section class={`reveal flex flex-col gap-3 ${card}`} style="--i: 3" id="about">
    <h2 class="text-sm font-medium text-muted">About</h2>
    <div class="flex flex-col gap-3 text-secondary leading-relaxed text-pretty tracking-[-0.005em]">
      <p>
        I build small, useful websites for everyday people: text-to-speech,
        image tools, calculators, file sharing, and more. Each one is built
        to scale, so it stays fast and cheap to run as traffic grows.
      </p>
      <p>
        Most of the work behind them is automated. I set up SEO, content,
        and social media workflows that run on their own, which is how one
        person can run a dozen websites.
        When a project needs something new, I learn it, ship it, and keep
        improving it.
      </p>
      <p class="text-foreground">
        My rule is simple: start small, stay consistent, build quietly, and
        let the results make the noise.
      </p>
    </div>
  </section>

  <section class="reveal flex scroll-mt-8 flex-col gap-4" style="--i: 4" id="projects">
    <div class={sectionHead}>
      <h2 class="text-sm font-medium text-muted">Projects</h2>
      <a href="/projects" class={moreLink}>All projects &rarr;</a>
    </div>
    <ProjectTabs sites={sites} headingLevel="h3" synced={!!payload} limit={6} />
  </section>

  <section class="reveal flex flex-col gap-4" style="--i: 5" id="writing">
    <div class={sectionHead}>
      <h2 class="text-sm font-medium text-muted">Writing</h2>
      <a href="/posts" class={moreLink}>All posts &rarr;</a>
    </div>
    <ul class="flex flex-col divide-y divide-border overflow-hidden rounded-xl border border-border bg-foreground/[0.02]">
      {
        posts.slice(0, 5).map((post) => (
          <li>
            <a
              class="group flex min-h-[44px] flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 hover:bg-foreground/[0.04]"
              href={`/posts/${post.id}`}
            >
              <span class="font-medium text-foreground">{post.data.title}</span>
              <time
                class="ml-auto shrink-0 text-sm whitespace-nowrap text-muted tabular-nums"
                datetime={post.data.pubDate.toISOString()}
              >
                {dateFmt.format(post.data.pubDate)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="reveal flex flex-col gap-4" style="--i: 6" id="elsewhere">
    <h2 class="text-sm font-medium text-muted">Elsewhere</h2>
    <ul class="grid gap-2 sm:grid-cols-3">
      {
        elsewhere.map((item) => (
          <li>
            <a
              href={item.href}
              {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class="flex h-full min-h-[44px] flex-col gap-0.5 rounded-xl border border-border bg-foreground/[0.02] px-4 py-3 transition-colors hover:border-foreground/25 hover:bg-foreground/[0.04]"
            >
              <span class="text-xs text-muted">{item.label}</span>
              <span class="min-w-0 font-medium break-words text-foreground">
                <span class="text-muted">{item.prefix}</span>
                {item.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class={`reveal flex scroll-mt-8 flex-col gap-5 ${card}`} style="--i: 7" id="contact">
    <div class="flex flex-col gap-1">
      <h2 class="text-sm font-medium text-muted">Stay in touch</h2>
      <p class="text-secondary leading-relaxed">
        Get occasional notes about new tools and writing, or send me a message.
      </p>
    </div>

    <form
      action="/api/subscribe"
      method="post"
      class="flex flex-col gap-2"
      data-async-form
      data-form-name="subscribe"
    >
      <label for="subscribe-email" class="text-sm font-medium text-foreground">
        Email updates
      </label>
      <div class="flex flex-col gap-2 sm:flex-row">
        <input
          id="subscribe-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          maxlength="254"
          placeholder="you@example.com"
          required
          class="min-h-[44px] w-full min-w-0 flex-1 rounded-md border border-border bg-foreground/[0.03] px-3 py-2 text-foreground placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        />
        <button
          type="submit"
          data-pending-label="Joining…"
          class="min-h-[44px] w-full rounded-md bg-foreground px-4 py-2 font-medium text-background hover:bg-foreground/90 focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
        >
          Join the list
        </button>
      </div>
      <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="subscribe-website">Website</label>
        <input id="subscribe-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p class="text-xs text-muted">Only occasional updates. Your address stays private.</p>
      <p class="form-status text-sm" data-form-status role="status" aria-live="polite" hidden></p>
    </form>

    <div class="h-px bg-border" aria-hidden="true"></div>

    <form
      action="/api/contact"
      method="post"
      class="flex flex-col gap-3"
      data-async-form
      data-form-name="contact"
    >
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
          Name
          <input
            name="name"
            type="text"
            autocomplete="name"
            maxlength="100"
            required
            class="min-h-[44px] w-full rounded-md border border-border bg-foreground/[0.03] px-3 py-2 font-normal text-foreground placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
          Email
          <input
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            required
            class="min-h-[44px] w-full rounded-md border border-border bg-foreground/[0.03] px-3 py-2 font-normal text-foreground placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </label>
      </div>
      <label class="flex flex-col gap-1.5 text-sm font-medium text-foreground">
        Message
        <textarea
          name="message"
          rows="5"
          minlength="10"
          maxlength="5000"
          required
          class="w-full resize-y rounded-md border border-border bg-foreground/[0.03] px-3 py-2 font-normal text-foreground placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        ></textarea>
      </label>
      <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="submit"
          data-pending-label="Sending…"
          class="min-h-[44px] w-full rounded-md bg-foreground px-4 py-2 font-medium text-background hover:bg-foreground/90 focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
        >
          Send message
        </button>
        <p class="form-status text-sm" data-form-status role="status" aria-live="polite" hidden></p>
      </div>
    </form>
  </section>

  <SiteFooter />
</Layout>

<script>
  import "../scripts/forms.ts";
</script>
