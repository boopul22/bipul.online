---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

// Rotate hover animations across cards, like the Indie Page
const spins = [
  "group-hover:-rotate-12",
  "group-hover:scale-[1.15]",
  "group-hover:rotate-12",
  "group-hover:-skew-y-12",
];
---

<Layout>
  <div class="mx-auto max-w-6xl px-5">
    <div class="md:flex md:items-start md:gap-10 lg:gap-14">
      <!-- Left: full-height pinned profile panel -->
      <div
        class="py-10 md:sticky md:top-0 md:h-screen md:w-[320px] md:shrink-0 md:overflow-y-auto md:py-12"
      >
        <Sidebar />
      </div>

      <!-- Right: scrolling project grid + footer (keeps the panel pinned full-height) -->
      <div class="flex flex-1 flex-col py-6 md:py-12">
        <main>
          <ul class="grid gap-3 sm:grid-cols-2 lg:gap-4">
            {
              projects.map((project, i) => (
                <ProjectCard project={project} spin={spins[i % spins.length]} />
              ))
            }
          </ul>
        </main>

        <footer class="mt-12 text-center text-sm text-ink/50 md:text-left">
          © {new Date().getFullYear()} Bipul Kumar · Build quietly.
          {' · '}
          <a href="https://extractpics.com/image-downloader" target="_blank" rel="noopener" class="text-ink/50 hover:text-ink transition-colors">image downloader</a>
          {' · '}
          <a href="https://freepromptbase.com/" target="_blank" rel="noopener" class="text-ink/50 hover:text-ink transition-colors">ai prompt</a>
        </footer>
      </div>
    </div>
  </div>
</Layout>

<!-- Hydrate cards with live GA4 traffic (no-op if the API isn't configured) -->
<script>
  import "../scripts/live-traffic.ts";
</script>
