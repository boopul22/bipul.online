---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /** Hover spin direction varies per card, like the Indie Page. */
  spin?: string;
}

const { project, spin = "group-hover:-rotate-12" } = Astro.props;

// --- Chart geometry ---
const W = 300;
const H = 90;
const PAD_Y = 10;

const data = project.chart;
const max = Math.max(...data);
const min = Math.min(...data);
const range = max - min || 1;

const points = data.map((v, i) => {
  const x = (i / (data.length - 1)) * W;
  const y = H - PAD_Y - ((v - min) / range) * (H - PAD_Y * 2);
  return [x, y] as [number, number];
});

// Catmull-Rom -> cubic Bézier smoothing
function smoothPath(pts: [number, number][]): string {
  if (pts.length < 2) return "";
  let d = `M ${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
    const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
    const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
    const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p2[0]},${p2[1]}`;
  }
  return d;
}

const linePath = smoothPath(points);
const areaPath = `${linePath} L ${W},${H} L 0,${H} Z`;
const gradId = `grad-${project.name.replace(/[^a-z0-9]/gi, "")}`;

const months = ["Jul", "Sep", "Nov", "Jan", "Mar", "May"];

// k-formatter: 14000 -> "14k", 6800 -> "6.8k", 940 -> "940"
function fmt(n: number): string {
  if (n >= 1000) {
    const k = n / 1000;
    return (k >= 10 ? Math.round(k).toString() : k.toFixed(1).replace(/\.0$/, "")) + "k";
  }
  return Math.round(n).toString();
}

const badgeValue = project.visits ?? data[data.length - 1];
const favicon =
  project.icon ?? `https://www.google.com/s2/favicons?sz=128&domain=${project.domain}`;
---

<li class="card overflow-hidden">
  <a
    href={project.url}
    target="_blank"
    rel="noopener"
    class="group block space-y-1.5 rounded-2xl p-4 no-underline transition-transform duration-200 hover:scale-[1.02] hover:bg-black/[0.02] lg:p-6"
  >
    <!-- Header: favicon + name + metric badge -->
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
      <img
        src={favicon}
        alt={`${project.name} logo`}
        width="20"
        height="20"
        loading="lazy"
        class={`h-4 w-4 rounded object-cover drop-shadow-sm transition-transform duration-200 lg:h-5 lg:w-5 ${spin}`}
      />
      <p class="mr-auto font-semibold text-ink lg:text-base">{project.name}</p>

      {
        project.status ? (
          <span class="inline-flex items-center gap-1 rounded-full bg-primary/15 px-2.5 py-0.5 text-xs font-semibold text-link">
            <span class="h-1.5 w-1.5 rounded-full bg-primary" />
            {project.status}
          </span>
        ) : (
          <span class="relative inline-flex items-center rounded-full bg-black/[0.06] py-0.5 pr-2.5 pl-6 text-xs font-semibold whitespace-nowrap text-ink/80">
            <span class="absolute -left-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-primary text-link">
              <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
            </span>
            {fmt(badgeValue)}/mo
          </span>
        )
      }
    </div>

    <!-- Tagline -->
    <p class="text-xs text-ink/70 lg:text-sm">{project.tagline}</p>

    <!-- Chart: y-axis min/max + area + month x-axis -->
    <div class="flex gap-2 pt-1">
      <div
        class="flex h-20 flex-col justify-between py-1 text-[10px] font-medium text-ink/40 lg:h-24"
      >
        <span>{fmt(max)}</span>
        <span>{fmt(min)}</span>
      </div>
      <div class="min-w-0 flex-1">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="h-20 w-full lg:h-24"
          preserveAspectRatio="none"
          role="img"
          aria-label={`Monthly visitors trend for ${project.name}`}
        >
          <defs>
            <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#e0a82e" stop-opacity="0.35"></stop>
              <stop offset="100%" stop-color="#e0a82e" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d={areaPath} fill={`url(#${gradId})`}></path>
          <path
            d={linePath}
            fill="none"
            stroke="#e0a82e"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="mt-1 flex justify-between text-[10px] text-ink/40">
          {months.map((m) => <span>{m}</span>)}
        </div>
      </div>
    </div>
  </a>
</li>
