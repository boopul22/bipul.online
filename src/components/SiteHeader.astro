---
interface Props {
  active?: "home" | "writing";
}

const { active = "home" } = Astro.props;

const pill = "rounded-md px-2 py-1 font-medium bg-foreground/5 text-foreground hover:bg-foreground/5";
const link = "rounded-md px-2 py-1 font-medium text-muted hover:bg-foreground/5 hover:text-foreground";
---

<header class="reveal flex items-center justify-between gap-4" style="--i: 0">
  <div class="flex min-w-0 items-center gap-2.5">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 text-foreground"
      aria-label="Bipul Kumar, home"
    >
      <span
        class="pulse-dot relative inline-flex size-2 shrink-0 rounded-full bg-success/80 text-success/80"
        aria-hidden="true"></span>
      <span class="font-medium tracking-tight">Bipul Kumar</span>
    </a>
    <span
      class="inline-flex items-center gap-1 text-sm text-muted tabular-nums"
      title="People across my tools right now"
    >
      &middot; <span class="js-live">&hellip;</span> online
    </span>
  </div>
  <nav class="flex shrink-0 items-center gap-1 text-sm">
    <a href="/" aria-current={active === "home" ? "page" : undefined} class={active === "home" ? pill : link}>
      Home
    </a>
    <span class="text-border" aria-hidden="true">·</span>
    <a
      href="/posts"
      aria-current={active === "writing" ? "page" : undefined}
      class={active === "writing" ? pill : link}
    >
      Writing
    </a>
  </nav>
</header>
