---
// "At a glance" tiles: site count and visitors/month.
import StatTile from "./StatTile.astro";
import type { ProjectWithProgress } from "../../lib/progress";

interface Props {
  sites: ProjectWithProgress[];
  class?: string;
  style?: string;
}

const { sites, class: className = "", style } = Astro.props;
---

<section class={`grid grid-cols-2 gap-2 sm:grid-cols-2 ${className}`} style={style} aria-label="At a glance">
  <StatTile label="Websites">{sites.length}</StatTile>
  <StatTile label="Visitors / month" hint="Across all websites, last 28 days">
    <span class="js-total">&hellip;</span>
  </StatTile>
</section>
