---
const email = "blog.boopul@gmail.com";

// Total monthly visitors is live GA4 data — summed client-side in
// live-traffic.ts (.js-total). Shows a spinner until that arrives.
const socials = [
  {
    label: "GitHub",
    url: "https://github.com/boopul22",
    path: "M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z",
  },
  {
    label: "Instagram",
    url: "https://instagram.com/bipul.skill",
    path: "M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 8a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2Zm6.3-8.2a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0Z",
  },
];
---

<aside>
  <!-- Avatar -->
  <img
    src="/profile.png"
    alt="Bipul Kumar"
    width="160"
    height="160"
    class="h-20 w-20 rounded-full object-cover lg:h-28 lg:w-28"
  />

  <h1 class="mt-4 font-heading text-[34px] leading-none font-extrabold text-ink">
    Bipul Kumar
  </h1>

  <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink/70">
    <span class="inline-flex items-center gap-1.5">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 21s-7-6.3-7-11a7 7 0 1 1 14 0c0 4.7-7 11-7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
      India
    </span>
    <span class="inline-flex items-center gap-1.5">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
        <circle cx="12" cy="12" r="2.5" />
      </svg>
      ~<span class="js-total inline-flex items-center"
        ><span
          class="h-3 w-3 animate-spin rounded-full border-2 border-ink/15 border-t-primary"
        ></span></span
      > visits/mo
    </span>
  </div>

  <p class="mt-5 text-base text-ink/70 italic">
    "I paid my own way through college and taught myself the rest. Still
    building."
  </p>

  <p class="mt-5 font-semibold text-link">
    Generalist. Whatever the project needs, I learn it and ship it.
  </p>
  <p class="mt-2 text-ink/70">
    I make small tools that solve real problems. No big team, no funding, just
    steady work. Here's what I've shipped 👇
  </p>

  <!-- Subscribe form: input (left-rounded) + button (right-rounded) -->
  <form
    class="mt-5 flex max-w-sm"
    action={`mailto:${email}`}
    method="post"
    enctype="text/plain"
  >
    <label for="sub-email" class="sr-only">Your email</label>
    <input
      id="sub-email"
      name="email"
      type="email"
      required
      placeholder="Your email..."
      class="input-field"
    />
    <button type="submit" class="btn-primary whitespace-nowrap">Subscribe</button>
  </form>

  <!-- Socials -->
  <div class="mt-5 flex items-center gap-3">
    {
      socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener"
          aria-label={s.label}
          class="flex h-10 w-10 items-center justify-center rounded-full bg-surface text-link transition-transform hover:-translate-y-0.5"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      ))
    }
    <a
      href={`mailto:${email}`}
      aria-label="Email"
      class="flex h-10 w-10 items-center justify-center rounded-full bg-surface text-link transition-transform hover:-translate-y-0.5"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
    </a>
  </div>

  <nav class="mt-5" aria-label="Tools">
    <a href="https://freetexttospeech.net/" target="_blank" rel="noopener noreferrer" class="font-semibold text-link">voicer tool</a>
  </nav>

  <!-- Primary CTA pill -->
  <a
    href="https://bipul.online/"
    target="_blank"
    rel="noopener"
    class="mt-6 inline-flex items-center gap-2 rounded-full bg-link px-5 py-3 text-sm font-semibold text-white no-underline transition-transform hover:-translate-y-0.5"
  >
    <span aria-hidden="true">🌐</span> Visit bipul.online
  </a>
</aside>
